# Copy this file to `.env` and fill in real values.
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to client code —
# never put a secret key here.

# --- Clerk ---
# Same Clerk application as bajaaj/ (the web app) — one Clerk app, two
# client SDKs. https://dashboard.clerk.com/~/api-keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- bajaaj/ (the web app doubles as this app's API backend) ---
# Local dev default. On a physical device this must be your machine's
# LAN IP (e.g. http://192.168.1.x:3000), not localhost — the device
# can't resolve your computer's localhost as itself.
EXPO_PUBLIC_API_URL="http://localhost:3000"
